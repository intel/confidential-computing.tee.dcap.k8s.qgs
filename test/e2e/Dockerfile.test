# Build context: repo root
#
# Extends intel-tdx-qgs:latest with:
#   - fake get_platform_info binary (fixed JSON, no SGX hardware needed)
#   - busybox static binary for kubectl-exec-based test verification

FROM rust:1.98.1-slim-trixie@sha256:f47a8de237dcbb0b0ce1099901e60a89728e3d51f24e664b40e947171538ade7 AS fake-builder
WORKDIR /src
COPY test/fake-platform-info/ .
RUN cargo build --release

FROM busybox:stable-musl@sha256:3c6ae8008e2c2eedd141725c30b20d9c36b026eb796688f88205845ef17aa213 AS busybox-stage

FROM intel-tdx-qgs:latest
COPY --from=fake-builder /src/target/release/fake-platform-info /usr/local/bin/get_platform_info
COPY --from=busybox-stage /bin/busybox /bin/busybox
